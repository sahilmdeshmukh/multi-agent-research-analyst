# Required — get from https://console.groq.com
GROQ_API_KEY=gsk_...

# Required — get from https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Optional — override default models
RESEARCHER_MODEL=llama-3.3-70b-versatile
CRITIC_MODEL=llama-3.3-70b-versatile
SYNTHESIZER_MODEL=llama-3.3-70b-versatile

# Optional — max critique loop iterations before forcing synthesizer
MAX_CRITIQUE_ROUNDS=3
